# GP API credentials for the reports (sandbox)
# Get them at https://developer.globalpayments.com
GP_API_APP_ID=your_gp_api_app_id
GP_API_APP_KEY=your_gp_api_app_key

# Portico keys for the /process-payment example only
# Replace these sample values with your actual API keys
PUBLIC_API_KEY=pkapi_your_public_key_here
SECRET_API_KEY=skapi_your_secret_key_here

# Flask debug mode, local development only
# FLASK_DEBUG=1
